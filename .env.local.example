# Nenhuma destas variáveis é obrigatória: lib/supabase/config.ts já traz a URL
# e a chave anon públicas do projeto como padrão. Copie para .env.local só se
# quiser apontar para outro projeto Supabase (staging, por exemplo).
#
# Nunca usar a chave service_role aqui — ela ignora o RLS.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# E-mail da conta usada no login por senha (a senha fica só no Supabase Auth).
PANEL_LOGIN_EMAIL=joaovitorrc10102002@gmail.com
